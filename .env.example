# ============================================
# HIBURI営業自動化システム - 環境変数設定
# ============================================
# このファイルを .env にコピーして値を設定してください
#   cp .env.example .env

# --- Notion API ---
# https://www.notion.so/my-integrations でインテグレーションを作成
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxx
# CRM管理用データベースID（事業者・医療機関の管理）
NOTION_CRM_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 実行ログ記録用データベースID
NOTION_LOG_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google Maps API ---
# https://console.cloud.google.com/ でPlaces API / Geocoding APIを有効化
GOOGLE_MAPS_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- メール設定 ---
# Outlookのプロファイル名（Windows環境 / pywin32使用時）
OUTLOOK_PROFILE_NAME=Outlook

# --- Claude API ---
# https://console.anthropic.com/ でAPIキーを取得
# メール文面のAI自動生成に使用（未設定でもテンプレート生成は動作）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- タイムゾーン ---
TZ=Asia/Tokyo
